# ─── Source data (police PDFs — never commit) ───
*.pdf
Input_*/

# ─── Generated output ───
# Per-department result CSVs ARE tracked so collaborators (e.g. advisor)
# can access them through the repo.  Only the large aggregate master
# files are ignored — they are regenerable and bloat the repo.
MASTER_*.csv

# NOTE: tracked CSVs contain individual-level police data. Keep this
# repo PRIVATE. Data committed now stays in git history even if removed
# later, so do not make the repo public without scrubbing history first.

# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ─── Virtual environments ───
.venv/
venv/
env/
.conda/

# ─── Jupyter / notebooks ───
.ipynb_checkpoints/

# ─── OS / editor cruft ───
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# ─── Local LLM / model artifacts (should never be in git) ───
*.gguf
*.bin
ollama/
.ollama/

# ─── Logs & scratch ───
*.log
server.log